#passes{--ivory:#F4F1EA;--ink:#0A0A10;--g:#039866;--b:#311FE5;--m:#C30498}
#passes *{box-sizing:border-box;margin:0;padding:0}
#passes{scroll-behavior:auto}
#passes{background:var(--ink);color:var(--ivory);font-family:'Jost',system-ui,sans-serif;-webkit-font-smoothing:antialiased;overflow-x:clip}
#passes button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
#passes a{color:inherit}
@property --a{syntax:'<angle>';inherits:false;initial-value:0deg}
#passes .neon{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden;background:#0E0A0B}
#passes .neon::before{content:"";position:absolute;inset:-25%;
  background:conic-gradient(from var(--a) at 50% 50%,#FF2D3C 0deg,#FF8A1E 30deg,#FFE62E 62deg,#9BFF3C 100deg,#2EFFA8 145deg,#2EE6FF 185deg,#4B6BFF 225deg,#8C42FF 262deg,#F02BFF 300deg,#FF2B9A 335deg,#FF2D3C 360deg);
  animation:pp_ang 4s linear infinite;filter:saturate(1.3) brightness(1.3)}
@keyframes pp_ang{to{--a:360deg}}
#passes .bloom{position:fixed;inset:var(--gl);z-index:1;pointer-events:none;border-radius:var(--gr);background:rgba(43,26,21,.9);filter:blur(var(--gb))}
#passes .screen{display:block;position:fixed;inset:var(--gw);z-index:1;pointer-events:none;border-radius:calc(var(--gr) * 3);background:rgba(43,26,21,.88);filter:blur(var(--gwb))}
#passes{--gl:9px;--gb:18px;--gr:46px;--gw:120px;--gwb:160px}
#passes .hdr{position:fixed;top:0;left:0;right:0;z-index:60;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:calc(var(--gl) + 22px) calc(var(--gl) + clamp(16px,2.4vw,36px)) 0}
#passes .hl{display:flex;align-items:center;gap:16px;justify-self:start}
#passes .hback{display:inline-flex;align-items:center;gap:8px;height:42px;padding:0 20px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;background:var(--ivory);color:var(--ink);transition:transform .2s}
#passes .hback svg{width:15px;height:15px;transition:transform .25s}
#passes .hback:hover svg{transform:translateX(-3px)}
#passes .brand{display:flex;align-items:center;gap:10px;text-decoration:none;justify-self:start;font-weight:600;letter-spacing:.22em;font-size:14px}
#passes .brand svg{width:26px}
#passes .pill{justify-self:end;display:inline-flex;align-items:center;height:42px;padding:0 20px;border-radius:999px;font-size:14px;font-weight:500;text-decoration:none;background:var(--ivory);color:var(--ink)}
#passes .seg{display:flex;padding:4px;border-radius:999px;background:rgba(244,241,234,.08);border:1px solid rgba(244,241,234,.18);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  opacity:0;transform:translateY(-10px);pointer-events:none;transition:opacity .5s,transform .5s}
#passes .seg.show{opacity:1;transform:none;pointer-events:auto}
#passes .seg button{height:36px;padding:0 22px;border-radius:999px;font-size:14px;opacity:.7;transition:background .3s,color .3s,opacity .3s}
#passes .seg button.on{background:var(--ivory);color:var(--ink);opacity:1;font-weight:600}
#passes .scene{position:relative;z-index:2;height:460vh}
#passes .pin{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
#passes .hero{position:absolute;inset:0;z-index:5;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:0 24px;will-change:transform,opacity}
#passes .hero .logo{width:clamp(70px,8vw,110px);filter:drop-shadow(0 0 30px rgba(108,92,255,.45))}
#passes .hero .logo circle{transform-origin:center;transform-box:fill-box;animation:pp_pop 1s cubic-bezier(.3,1.6,.5,1) both}
#passes .hero .logo circle:nth-child(2){animation-delay:.12s}
#passes .hero .logo circle:nth-child(3){animation-delay:.24s}
@keyframes pp_pop{from{transform:scale(0)}to{transform:scale(1)}}
#passes .hero .word{margin-top:22px;font-weight:600;letter-spacing:.5em;padding-left:.5em;font-size:clamp(18px,2vw,26px)}
#passes .hero h1{margin-top:28px;font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(40px,6vw,96px);line-height:1;letter-spacing:-.01em}
#passes .hero h1 em{font-style:italic;font-weight:500;color:#fff}
#passes .hero h1 .mb{display:none}
#passes .hero p{margin-top:18px;font-size:clamp(15px,1.3vw,18px);opacity:.7;max-width:46ch;line-height:1.6}
#passes .pcue{position:absolute;left:50%;bottom:34px;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:10px;font-size:11px;letter-spacing:.3em;text-transform:uppercase;opacity:.6}
#passes .pcue i{width:1px;height:38px;background:currentColor;transform-origin:top;animation:pp_cue 2s ease-in-out infinite}
@keyframes pp_cue{0%{transform:scaleY(0)}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
#passes .sh{position:absolute;left:0;right:0;top:calc(var(--gl) + 86px);z-index:6;text-align:center;opacity:0;will-change:transform,opacity}
#passes .sh h2{font-family:'Playfair Display',Georgia,serif;font-weight:700;color:#fff;font-size:clamp(30px,3.6vw,56px);line-height:1}
#passes .sh h2 em{font-style:italic;font-weight:700;color:#fff}
#passes .phint{position:absolute;left:0;right:0;z-index:9;text-align:center;font-size:14px;letter-spacing:.06em;font-weight:500;color:#fff;opacity:0;transition:opacity .5s;pointer-events:none}
#passes .phint::before{content:"";display:inline-block;width:6px;height:6px;margin-right:8px;vertical-align:middle;border-radius:50%;background:#fff;animation:pp_hp 1.6s ease-in-out infinite}
@keyframes pp_hp{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1.2)}}
#passes .phint .hm{display:none}
@media (max-width:820px){#passes .phint .hd{display:none}
#passes .phint .hm{display:inline}
#passes .phint{font-size:12.5px}}
#passes .sh p{margin-top:12px;font-size:14px;letter-spacing:.26em;text-transform:uppercase;font-weight:700;color:#fff}
#passes .deck{position:absolute;left:50%;top:56%;width:0;height:0;z-index:8;perspective:1600px}
#passes .card{position:absolute;left:0;top:0;width:var(--cw);height:var(--ch);margin:calc(var(--ch) / -2) 0 0 calc(var(--cw) / -2);transform-style:preserve-3d;will-change:transform}
#passes .card .in{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .9s cubic-bezier(.25,.9,.3,1.15)}
#passes .face{position:absolute;inset:0;border-radius:calc(var(--cw) * .07);overflow:hidden;backface-visibility:hidden;-webkit-backface-visibility:hidden}
#passes .back{background:var(--bbg,#311FE5);color:var(--bfg,#fff);border:1.5px solid rgba(255,255,255,.7);box-shadow:0 30px 60px -24px rgba(0,0,0,.7)}
#passes .back svg{position:absolute;inset:0;width:100%;height:100%}
#passes .front{transform:rotateY(180deg);background:var(--bgc);color:var(--fg);padding:calc(var(--cw) * .08);display:flex;flex-direction:column;
  box-shadow:0 30px 60px -24px rgba(0,0,0,.75),inset 0 0 0 1px rgba(255,255,255,.2)}
#passes .front .pat{position:absolute;inset:0;opacity:.16;pointer-events:none;color:var(--fg)}
#passes .front .pat svg{width:100%;height:100%}
#passes .front>*:not(.pat){position:relative}
#passes .front .top{display:flex;justify-content:flex-end;align-items:center}
#passes .front .top span{font-size:calc(var(--cw) * .034);letter-spacing:.22em;text-transform:uppercase;font-weight:700;padding:5px 11px;border:1.5px solid currentColor;border-radius:999px}
#passes .front .lg{display:flex;align-items:center;gap:calc(var(--cw) * .025)}
#passes .front .lg svg{width:calc(var(--cw) * .1)}
#passes .front .lg b{font-size:calc(var(--cw) * .05);letter-spacing:.24em;font-weight:700}
#passes .front .mid{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);text-align:center}
#passes .back .nm{color:var(--bfg);position:absolute!important;left:6%;right:6%;top:50%;transform:translateY(-50%);text-align:center;font-family:'Playfair Display',Georgia,serif;font-weight:700;font-style:italic;
  font-size:calc(var(--cw) * .2);line-height:1;word-break:break-word;opacity:.7;text-shadow:0 1px 0 rgba(255,255,255,.6),0 -1px 0 rgba(0,0,0,.25);cursor:text;outline:none;border-radius:10px;padding:4px 0;min-height:1em}
#passes .back .nm:focus{opacity:1;background:rgba(255,255,255,.18)}
#passes .front .acc{display:inline-block;padding:calc(var(--cw) * .022) calc(var(--cw) * .05);border-radius:999px;background:var(--fg);color:var(--btx);
  font-size:calc(var(--cw) * .045);font-weight:700;letter-spacing:.06em}
#passes .front .bot{display:flex;justify-content:space-between;align-items:flex-end}
#passes .front h3{font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:calc(var(--cw) * .11);line-height:1}
#passes .front .pr{margin-top:6px;font-weight:700;font-size:calc(var(--cw) * .05)}
#passes .front .pr em{font-style:normal;font-weight:500;opacity:.7;font-size:.8em}
#passes .front .tap{font-size:calc(var(--cw) * .034);font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.75}
#passes .card{cursor:pointer}
#passes .dt{position:absolute;z-index:12;top:50%;width:min(420px,34vw);transform:translateY(-50%);opacity:0;pointer-events:none;transition:opacity .45s;color:#fff}
#passes .dt.show{opacity:1;pointer-events:auto}
#passes .dt .dx{position:absolute;z-index:3;cursor:pointer;right:0;top:-54px;width:38px;height:38px;border-radius:50%;border:1px solid rgba(255,255,255,.35);font-size:20px;line-height:1;color:#fff}
#passes .dt .sg{display:grid;grid-template-columns:repeat(3,1fr);gap:26px 12px}
#passes .dt .sg div{display:flex;flex-direction:column;align-items:center;gap:10px;text-align:center;font-size:13px;font-weight:600;line-height:1.3}
#passes .dt .sg i{width:54px;height:54px;border-radius:50%;border:1.3px solid rgba(255,255,255,.35);display:grid;place-items:center;transition:background .3s,color .3s,border-color .3s}
#passes .dt .sg svg{width:24px;height:24px}
#passes .dt .sg div:hover i{border-color:transparent;background:var(--dbg);color:var(--dfg)}
#passes .dt .dp{margin-top:34px;display:flex;align-items:baseline;gap:10px}
#passes .dt .dp s{font-size:16px;opacity:.5}
#passes .dt .dp b{font-size:32px;font-weight:700}
#passes .dt .dp em{font-style:normal;font-size:14px;opacity:.7}
#passes .dt input{display:block;width:100%;margin-top:14px;height:48px;padding:0 16px;border-radius:12px;border:1px solid rgba(255,255,255,.3);background:transparent;color:#fff;font:inherit;font-size:16px;outline:none}
#passes .dt input:focus{border-color:#fff}
#passes .dt a.buy{margin-top:12px;display:flex;align-items:center;justify-content:center;height:52px;border-radius:12px;background:var(--dbg);color:var(--dfg);text-decoration:none;font-weight:700;letter-spacing:.12em;text-transform:uppercase;font-size:14px}
#passes .card.open .in{transform:rotateY(180deg)}
#passes .edots{position:absolute;left:0;right:0;bottom:12px;z-index:4;display:none;justify-content:center;gap:8px;opacity:0}
#passes .edots button{width:8px;height:8px;border-radius:999px;background:rgba(255,255,255,.3);transition:width .3s,background .3s}
#passes .edots button.on{width:26px;background:#fff}
@font-face{font-family:'Alta';src:url('Alta-Regular.woff2') format('woff2'),url('Alta-Regular.otf') format('opentype');font-weight:400 700;font-display:swap}
#passes .card .face,#passes .card .face *{font-family:'Alta','Jost',sans-serif}
#passes .card .face .nm{font-style:normal;letter-spacing:.02em}
#passes .card .face .lg svg circle{fill:#fff}
#passes .card .face .lg svg{filter:drop-shadow(0 1px 2px rgba(0,0,0,.35))}
#passes .card .face .lg b{color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.35)}
#passes .back .top{position:absolute;top:calc(var(--cw) * .08);right:calc(var(--cw) * .08);display:flex}
#passes .back .lg{display:flex;align-items:center;gap:calc(var(--cw) * .025)}
#passes .back .lg svg{position:static;inset:auto;width:calc(var(--cw) * .1);height:auto;flex:none}
#passes .back .lg b{font-size:calc(var(--cw) * .05);letter-spacing:.24em;font-weight:700}
#passes .card .face .acc,#passes .card .face .nm{font-family:ui-monospace,'SF Mono','Menlo','Consolas','Courier New',monospace!important;text-transform:uppercase;font-style:normal;font-weight:600;
  background:none!important;padding:0!important;border-radius:0;color:color-mix(in srgb,var(--fg,#000) 48%,transparent)!important;opacity:1!important;
  text-shadow:0 1px 0 rgba(255,255,255,.42),0 -1px 0 rgba(0,0,0,.28)}
#passes .card .back .nm{color:color-mix(in srgb,var(--bfg,#000) 48%,transparent)!important}
#passes .card .face .acc{font-size:calc(var(--cw) * .05);letter-spacing:.14em}
#passes .card .face .nm{font-size:calc(var(--cw) * .085);letter-spacing:.16em;line-height:1.2}
#passes .card .face .nm:focus{background:rgba(255,255,255,.12)!important}
#passes .card .face .lg{gap:calc(var(--cw) * .024)!important;align-items:center}
#passes .card .face .lg svg{width:calc(var(--cw) * .062)!important;height:auto!important;display:block}
#passes .card .face .lg b{font-size:calc(var(--cw) * .06)!important;line-height:1!important;letter-spacing:.2em!important;font-weight:600!important;margin-right:-.2em}
#passes .card .face>*{z-index:1}
#passes .card .face::before{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:0;
  background:url(pass-texture.png) 0 0/150px 150px repeat;mix-blend-mode:overlay;opacity:.42}
#passes .card .face::after{content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;z-index:0;
  background:url(pass-texture.png) 0 0/150px 150px repeat;mix-blend-mode:multiply;opacity:.08}
#passes .hdr .hback,#passes .hdr .pill{height:32px!important;padding:0 14px!important;gap:8px;font-size:14px!important;line-height:20px;font-weight:500}
#passes .hdr .hback svg{width:14px!important;height:14px!important}
@media (max-width:767px){#passes .hdr .hback,#passes .hdr .pill{font-size:12px!important;height:28px!important}}
#passes .marr{position:absolute;left:0;right:0;z-index:9;display:none;justify-content:center;gap:64px;opacity:0;pointer-events:none;transition:opacity .5s}
#passes .marr button{width:52px;height:52px;border-radius:50%;display:grid;place-items:center;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.28);
  backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);transition:background .25s,opacity .25s,transform .15s}
#passes .marr button svg{width:22px;height:22px}
#passes .marr button:active{transform:scale(.92);background:rgba(255,255,255,.2)}
#passes .marr button:disabled{opacity:.3}
#passes .mtabs{position:absolute;left:0;right:0;bottom:calc(env(safe-area-inset-bottom,0px) + 24px);z-index:9;display:none;justify-content:center;gap:8px;opacity:0;transition:opacity .5s}
#passes .mtabs button{width:8px;height:8px;border-radius:999px;background:rgba(244,241,234,.3);transition:width .3s,background .3s}
#passes .mtabs button.on{width:26px;background:var(--ivory)}
#passes .after{height:40vh;position:relative;z-index:2}
#passes .eco{position:relative;z-index:2;height:330vh}
#passes .vidsec{position:relative;z-index:2;height:220vh;background:#000}
#passes .vidsec .vpin{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
#passes .vidsec video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#passes .st.sv{background:#000;color:#fff}
#passes .st.sv .stage{position:absolute;inset:0}
#passes .st.sv .stx{position:relative;margin-top:auto;z-index:2;background:linear-gradient(to top,rgba(0,0,0,.55),transparent);padding-top:60px;text-shadow:0 1px 10px rgba(0,0,0,.45)}
#passes .st.sv .stx p{opacity:.92}
#passes .st.sv .num{color:#fff;opacity:.7}
#passes .eco .half,#passes .eco .hairc{display:none!important}
#passes .epin{position:sticky;top:0;height:100vh;height:100svh}
#passes .ewin{position:absolute;inset:0;border-radius:0;overflow:hidden;background:#050507;perspective:1400px;isolation:isolate}
#passes .half{position:absolute;inset:-6%;z-index:4;will-change:transform;transform-style:preserve-3d}
#passes .half .tex{position:absolute;inset:-4%;background:url(eco/hair-split.jpg) center/cover no-repeat;will-change:transform}
#passes .half::after{content:"";position:absolute;inset:0;background:radial-gradient(120% 90% at 50% 50%,transparent 40%,rgba(0,0,0,.55));pointer-events:none}
#passes .half.top,#passes .half.bot{transform-origin:0 50%;-webkit-mask-size:100% 100%;mask-size:100% 100%;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat}
#passes .half video.tex{inset:auto;left:-4%;top:-4%;width:108%;height:108%;object-fit:cover;background:#000}
#passes .stv video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
#passes .hairc{position:absolute;inset:0;z-index:5;width:100%;height:100%;pointer-events:none}
#passes .half.top::before,#passes .half.bot::before{content:"";position:absolute;left:0;right:0;height:10%;z-index:1;pointer-events:none}
#passes .half.top::before{bottom:50%;background:linear-gradient(180deg,transparent,rgba(0,0,0,.45))}
#passes .half.bot::before{top:50%;background:linear-gradient(0deg,transparent,rgba(0,0,0,.45))}
#passes .crackl{display:none!important}
#passes .crackl{position:absolute;inset:0;z-index:5;width:100%;height:100%;pointer-events:none;overflow:visible}
#passes .crackl path{fill:none;stroke:#E9FFF4;stroke-width:2.2;stroke-linejoin:round;filter:drop-shadow(0 0 6px #2CE0A0) drop-shadow(0 0 16px #2CE0A0)}
#passes .etitle{position:absolute;left:0;right:0;top:50%;z-index:2;text-align:center;padding:0 24px;will-change:transform,opacity}
#passes .etitle .ey{font-size:12px;letter-spacing:.34em;text-transform:uppercase;font-weight:600;color:#fff;opacity:.75}
#passes .etitle h2{margin-top:10px;font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:clamp(38px,6.4vw,104px);line-height:1;letter-spacing:-.01em;
  color:#fff;text-shadow:0 0 30px rgba(255,255,255,.18),0 0 80px rgba(255,255,255,.1)}
#passes .etitle h2 em{font-style:italic;font-weight:500;color:#fff}
#passes .etitle .kick{margin-top:16px;font-size:clamp(17px,1.9vw,28px);font-weight:500;color:#fff;opacity:.92}
#passes .etitle .sub{display:inline-block;margin-top:22px;padding:10px 24px;border:1.5px solid rgba(255,255,255,.55);border-radius:999px;font-size:clamp(13px,1.15vw,17px);color:#fff;opacity:.9}
#passes .eglow{position:absolute;left:50%;top:50%;width:70vmax;height:40vmax;margin:-20vmax 0 0 -35vmax;z-index:1;border-radius:50%;
  background:radial-gradient(closest-side,rgba(3,152,102,.42),rgba(49,31,229,.12) 60%,transparent);filter:blur(20px);opacity:0}
#passes .psteps{position:absolute;left:clamp(14px,2.4vw,34px);right:clamp(14px,2.4vw,34px);bottom:clamp(14px,2.4vw,34px);height:var(--sth,60%);z-index:3;
  display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(10px,1.2vw,18px);perspective:1600px}
#passes .st{position:relative;border-radius:clamp(20px,2vw,30px);background:#EFE9DC;color:#13261D;display:flex;flex-direction:column;overflow:hidden;
  will-change:transform,opacity;opacity:0;box-shadow:0 30px 70px -30px rgba(0,0,0,.8)}
#passes .st.g{background:#0D4A35;color:#EFE9DC}
#passes .stage{position:relative;flex:1;min-height:0;perspective:900px;overflow:hidden}
#passes .stx{padding:0 clamp(18px,1.8vw,28px) clamp(18px,1.8vw,26px)}
#passes .stx .k{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:.26em;font-weight:700;text-transform:uppercase;padding:6px 12px;border-radius:999px;border:1.5px solid currentColor;opacity:.85}
#passes .stx h3{margin-top:12px;font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:clamp(26px,2.3vw,38px);line-height:1}
#passes .stx p{margin-top:10px;font-size:clamp(13px,1vw,15px);line-height:1.55;opacity:.78;max-width:40ch}
#passes .st .num{position:absolute;right:clamp(16px,1.6vw,24px);top:clamp(12px,1.2vw,18px);font-family:'Playfair Display',Georgia,serif;font-weight:700;font-size:clamp(20px,1.6vw,26px);opacity:.35;z-index:3}
#passes .c3{position:absolute;left:50%;top:52%;width:0;height:0;transform-style:preserve-3d}
#passes .orb{transform-style:preserve-3d;transform:rotateX(-16deg)}
#passes .spin{transform-style:preserve-3d;animation:pp_oy 14s linear infinite}
@keyframes pp_oy{to{transform:rotateY(360deg)}}
#passes .disc{position:absolute;width:calc(var(--u) * 46);height:calc(var(--u) * 46);margin:calc(var(--u) * -23) 0 0 calc(var(--u) * -23);border-radius:50%;
  background:radial-gradient(circle at 35% 30%,#FFF8EA,#E7DCC3 60%,#CDBF9F);box-shadow:inset -10px -14px 30px rgba(0,0,0,.18),0 0 60px rgba(124,242,196,.25)}
#passes .disc svg{position:absolute;left:30%;top:32%;width:40%}
#passes .lk{position:absolute;width:calc(var(--u) * 10);height:calc(var(--u) * 34);margin:calc(var(--u) * -17) 0 0 calc(var(--u) * -5);transform-style:preserve-3d}
#passes .lk b{display:block;width:100%;height:100%;animation:pp_oyr 14s linear infinite;border-radius:calc(var(--u) * 2) calc(var(--u) * 2) 45% 45% / calc(var(--u) * 2) calc(var(--u) * 2) 18% 18%;
  background:url(eco/hair-split.jpg) no-repeat;background-size:900% 300%;box-shadow:0 12px 18px -6px rgba(0,0,0,.5),inset 0 0 0 1px rgba(255,255,255,.12)}
#passes .lk b::before{content:"";position:absolute;left:-6%;right:-6%;top:12%;height:calc(var(--u) * 2.4);border-radius:4px;background:#F4F1EA;box-shadow:0 2px 4px rgba(0,0,0,.3)}
#passes .lk b{position:relative}
@keyframes pp_oyr{to{transform:rotateY(-360deg)}}
#passes .tw{position:absolute;left:40%;top:60%;width:0;height:0;transform-style:preserve-3d;transform:rotateX(58deg) rotateZ(-8deg)}
#passes .row{position:absolute;transform-style:preserve-3d}
#passes .dz{position:absolute;width:calc(var(--u) * 50);height:calc(var(--u) * 26);margin:calc(var(--u) * -13) 0 0 calc(var(--u) * -25);transform-style:preserve-3d;animation:pp_twz 5s ease-in-out infinite alternate}
#passes .dz i{position:absolute;inset:0;border-radius:999px;background:var(--c)}
#passes .dz i.t{box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.25)}
@keyframes pp_twz{from{transform:rotateZ(-28deg)}to{transform:rotateZ(28deg)}}
#passes .lb{position:absolute;left:calc(var(--u) * 30);top:0;white-space:nowrap;transform-origin:0 0;transform:rotateZ(8deg) rotateX(-58deg) translateY(-50%);display:flex;align-items:center;gap:8px;
  font-size:calc(var(--u) * 3.6);font-weight:600;letter-spacing:.04em;color:#13261D}
#passes .lb::before{content:"";width:calc(var(--u) * 8);height:1px;background:currentColor;opacity:.4}
#passes .gc{position:absolute;width:calc(var(--u) * 78);height:calc(var(--u) * 78);margin:calc(var(--u) * -39) 0 0 calc(var(--u) * -39);border-radius:50%;transform:translateZ(calc(var(--u) * -38));
  background:radial-gradient(circle at 40% 35%,#22C58C,#039866 55%,#06704C);box-shadow:inset -14px -20px 40px rgba(0,0,0,.25)}
#passes .ht{position:absolute;width:calc(var(--u) * 100);height:calc(var(--u) * 92);margin:calc(var(--u) * -51) 0 0 calc(var(--u) * -50);transform-style:preserve-3d;animation:pp_rock 6s ease-in-out infinite alternate}
#passes .ht img{width:100%;height:100%;object-fit:contain}
@keyframes pp_rock{from{transform:rotateY(-16deg) translateY(4px)}to{transform:rotateY(16deg) translateY(-4px)}}
#passes .lorb{transform-style:preserve-3d;transform:rotateX(72deg)}
#passes .lspin{transform-style:preserve-3d;animation:pp_lz 10s linear infinite}
@keyframes pp_lz{to{transform:rotateZ(360deg)}}
#passes .lf{position:absolute;width:calc(var(--u) * 11);height:calc(var(--u) * 11);margin:calc(var(--u) * -5.5) 0 0 calc(var(--u) * -5.5);transform-style:preserve-3d}
#passes .lf img{width:100%;height:100%;object-fit:contain;animation:pp_lfz 10s linear infinite}
@keyframes pp_lfz{from{transform:rotateZ(0) rotateX(-72deg)}to{transform:rotateZ(-360deg) rotateX(-72deg)}}
#passes .c3 .disc{animation:pp_dtilt 7s ease-in-out infinite alternate}
@keyframes pp_dtilt{from{transform:rotateY(-18deg) rotateX(6deg)}to{transform:rotateY(18deg) rotateX(-6deg)}}
#passes #strands{position:absolute;left:0;top:0;transform-style:preserve-3d}
#passes .bin{position:absolute;width:calc(var(--u) * 62);height:calc(var(--u) * 84.6);margin:calc(var(--u) * -37) 0 0 calc(var(--u) * -31);transform:translateZ(calc(var(--u) * 10));transform-style:preserve-3d}
#passes .bin::before{content:"";position:absolute;left:8%;right:8%;bottom:-5%;height:12%;border-radius:50%;background:radial-gradient(closest-side,rgba(0,0,0,.4),transparent);transform:translateZ(-1px)}
#passes .bin img{position:relative;width:100%;height:100%;object-fit:contain;animation:pp_rock 7s ease-in-out infinite alternate}
#passes .hs{position:absolute;left:0;top:0;width:calc(var(--u) * 6);height:calc(var(--u) * 32);margin:calc(var(--u) * -16) 0 0 calc(var(--u) * -3);opacity:0;will-change:transform,opacity}
#passes .hs svg{width:100%;height:100%;overflow:visible}
@keyframes pp_hfall{0%{opacity:0;transform:translate3d(calc(var(--x) * var(--u)),calc(var(--u) * -70),calc(var(--z) * var(--u))) rotateZ(var(--r)) rotateY(0deg)}
  15%{opacity:1}72%{opacity:1}
  100%{opacity:0;transform:translate3d(calc(var(--x) * var(--u) * .25),calc(var(--u) * 6),calc(var(--z) * var(--u) * .3)) rotateZ(calc(var(--r) * -1)) rotateY(540deg) scale(.7)}}
#passes .jar{position:absolute;width:calc(var(--u) * 42);height:calc(var(--u) * 61.5);margin:calc(var(--u) * -32) 0 0 calc(var(--u) * -21);transform-style:preserve-3d;animation:pp_rock 6s ease-in-out infinite alternate}
#passes .jar img{width:100%;height:100%;object-fit:contain}
#passes .mound{position:absolute;width:calc(var(--u) * 112);height:calc(var(--u) * 111.6);margin:calc(var(--u) * -61) 0 0 calc(var(--u) * -56);transform-style:preserve-3d;animation:pp_mfloat 6s ease-in-out infinite alternate}
#passes .mound img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain}
#passes .mound .sprout{transform-origin:55.3% 42.6%;animation:pp_sway 3.4s ease-in-out infinite alternate}
@keyframes pp_sway{from{transform:rotate(-6deg) scale(.96)}to{transform:rotate(5deg) scale(1.04)}}
@keyframes pp_mfloat{from{transform:rotateY(-12deg) translateY(4px)}to{transform:rotateY(12deg) translateY(-4px)}}
#passes .porb{transform-style:preserve-3d;transform:rotateX(74deg) rotateY(-10deg)}
#passes .pspin{transform-style:preserve-3d;animation:pp_lz 9s linear infinite}
#passes .pt{position:absolute;width:calc(var(--u) * var(--s));height:calc(var(--u) * var(--s));margin:calc(var(--u) * var(--s) / -2) 0 0 calc(var(--u) * var(--s) / -2);transform-style:preserve-3d}
#passes .pt i{display:block;width:100%;height:100%;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.7),var(--c) 45%,color-mix(in srgb,var(--c) 70%,#000));
  animation:pp_pz 9s linear infinite;box-shadow:0 0 10px color-mix(in srgb,var(--c) 50%,transparent)}
@keyframes pp_pz{from{transform:rotateZ(calc(var(--a) * -1)) rotateX(-74deg)}to{transform:rotateZ(calc(var(--a) * -1 - 360deg)) rotateX(-74deg)}}
@media (max-width:820px){#passes .psteps{display:flex;gap:12px;left:0;right:auto;padding:0 14px;bottom:34px;will-change:transform;touch-action:pan-y}
#passes .edots{display:flex}
#passes .st{width:calc(100vw - 2 * var(--gl) - 20px - 28px);flex:none}
#passes .etitle .ey{font-size:10px;letter-spacing:.26em}
#passes .tw{left:34%}
#passes .half .tex{background-image:url(eco/hair-split-m.jpg);inset:-2%}
#passes .hdr{grid-template-columns:auto 1fr auto;gap:10px;padding:calc(var(--gl) + 14px) calc(var(--gl) + 12px) 0}
#passes{--gl:6px;--gb:11px;--gr:30px;--gw:60px;--gwb:90px}
#passes .brand span{display:none}
#passes .seg{justify-self:center}
#passes .seg button{height:32px;padding:0 16px;font-size:13px}
#passes .mtabs{display:flex}
#passes .marr{display:flex}
#passes .dt{width:auto;left:20px;right:20px;transform:none}
#passes .dt .dx{top:auto;bottom:calc(100% + 20px);right:0;width:34px;height:34px;font-size:18px}
#passes .dt .sg{grid-template-columns:repeat(4,1fr);gap:14px 4px}
#passes .hero h1{font-size:clamp(40px,11vw,52px);line-height:1.05}
#passes .hero h1 .mb{display:inline}
#passes .hero p{max-width:30ch}
#passes .dt .sg div{font-size:11px;gap:6px}
#passes .dt .sg i{width:44px;height:44px}
#passes .dt .sg svg{width:20px;height:20px}
#passes .dt .dp{margin-top:20px;flex-wrap:wrap;gap:6px}
#passes .dt .dp b{font-size:22px}
#passes .dt .dp s{font-size:13px}
#passes .dt .dp em{font-size:12px}
#passes .dt input{height:42px;font-size:14px;margin-top:10px}
#passes .dt a.buy{height:44px;font-size:12px}}
@media (prefers-reduced-motion:reduce){#passes .neon::before{animation-duration:12s}
#passes .pcue i{animation:none}}
#passes{position:relative;z-index:10;background:#0A0A10;color:#F4F1EA;font-family:'Jost',system-ui,sans-serif;isolation:auto}
#passes .sh .seg{display:inline-flex;margin-top:14px}
html.pp-on #gl{opacity:0!important;visibility:hidden!important}
html.pp-on .nav{--fg-rgb:244,241,234}
html.pp-on .rail{opacity:.4}
